# Seatbelt only; the enforced rules live in the GitHub ruleset and the security-guard CI check.

branch=$(git symbolic-ref --short -q HEAD)
case "$branch" in
  main)
    echo "" >&2
    echo "âŒ Committing directly on '$branch' is not allowed." >&2
